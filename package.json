{"name":"lumacast","version":"1.0.0","private":true,"type":"module","engines":{"node":">=20"},"scripts":{"dev":"concurrently -k -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"","dev:client":"vite --config client/vite.config.ts --configLoader runner","dev:server":"tsx watch server/src/server.ts","build":"npm run build:client && npm run build:server","build:client":"vite build --config client/vite.config.ts --configLoader runner","build:server":"tsc -p server/tsconfig.json","typecheck":"tsc -p client/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit","start":"node server/dist/server.js","test:signal":"node tests/signaling-smoke.mjs","test:load":"node tests/signaling-load.mjs","test:security":"node tests/security-smoke.mjs"},"dependencies":{"agora-rtc-sdk-ng":"^4.24.8","agora-token":"^2.0.6","cors":"^2.8.5","dotenv":"^16.6.1","express":"^5.1.0","express-rate-limit":"^8.1.0","livekit-client":"^2.22.3","livekit-server-sdk":"^2.19.1","lucide-react":"^0.468.0","react":"^19.1.1","react-dom":"^19.1.1","socket.io":"^4.8.1","socket.io-client":"^4.8.1"},"devDependencies":{"@types/cors":"^2.8.19","@types/express":"^5.0.3","@types/node":"^22.18.6","@types/react":"^19.1.16","@types/react-dom":"^19.1.9","@vitejs/plugin-react":"^5.0.4","concurrently":"^9.2.1","tsx":"^4.20.5","typescript":"^5.9.2","vite":"^7.1.7"}}