<Window x:Class="LuniraScreen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Lunira Screen"
        Icon="Assets/Lunira.ico"
        Width="1380"
        Height="860"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#090A0F">
  <Grid Background="#090A0F">
    <wv2:WebView2 x:Name="Browser" Visibility="Collapsed"/>

    <Grid x:Name="LoadingPanel" Background="#090A0F">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
        <Border Width="72" Height="72" CornerRadius="18" Background="#7C5CFF"
                HorizontalAlignment="Center" Margin="0,0,0,22">
          <Viewbox Margin="16">
            <Canvas Width="64" Height="64">
              <Path Data="M17,20 L47,20 L47,40 L17,40 Z"
                    Stroke="White" StrokeThickness="5" StrokeLineJoin="Round" Fill="Transparent"/>
              <Path Data="M25,48 L39,48 M32,40 L32,48"
                    Stroke="White" StrokeThickness="5"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Ellipse Canvas.Left="37" Canvas.Top="14" Width="14" Height="14" Fill="#FF4D79"/>
            </Canvas>
          </Viewbox>
        </Border>
        <TextBlock Text="Lunira Screen" Foreground="#F5F4FA" FontSize="24"
                   FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock x:Name="LoadingText" Text="Conectando..." Foreground="#999BAB"
                   FontSize="13" Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>

    <Grid x:Name="ErrorPanel" Background="#090A0F" Visibility="Collapsed">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="500">
        <TextBlock Text="Não foi possível abrir o Lunira Screen"
                   Foreground="#F5F4FA" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/>
        <TextBlock x:Name="ErrorText" Foreground="#9B9DAD" FontSize="14"
                   Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
        <TextBlock x:Name="CurrentUrl" Foreground="#676979" FontSize="12"
                   Margin="0,10,0,22" TextWrapping="Wrap" TextAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Content="Tentar novamente" Click="Retry_Click"
                  Padding="18,10" Margin="0,0,10,0" Background="#7657FF"
                  Foreground="White" BorderThickness="0"/>
          <Button Content="Abrir no navegador" Click="OpenBrowser_Click"
                  Padding="18,10" Background="#1B1C25" Foreground="#ECECF3"
                  BorderBrush="#343645"/>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
