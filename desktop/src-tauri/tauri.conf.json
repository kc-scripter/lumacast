{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lunira Screen",
  "version": "0.1.4",
  "identifier": "com.lunira.screen",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Lunira Screen",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "useHttpsScheme": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "shortDescription": "Compartilhamento de tela em tempo real",
    "longDescription": "Lunira Screen Desktop — salas compatíveis com o Lunira Screen Web.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
