{
  "name": "lunira-screen-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Cliente Windows do Lunira Screen, compatível com as mesmas salas da versão web.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "node scripts/write-config.cjs && electron-builder --win nsis",
    "dist:portable": "node scripts/write-config.cjs && electron-builder --win portable"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "44.4.0",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "com.lunirascreen.desktop",
    "productName": "Lunira Screen",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "picker.html",
      "picker-preload.cjs",
      "config.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Lunira-Screen-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
