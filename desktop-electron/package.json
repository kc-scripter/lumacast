{
  "name": "lunirascreen-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "sync-renderer": "node prepare.mjs",
    "dev": "npm run sync-renderer && electron .",
    "package:win": "npm run sync-renderer && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "com.lunira.screen",
    "productName": "Lunira Screen",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "renderer/**/*",
      "package.json",
      "build/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "LuniraScreen-Desktop-${version}.${ext}",
      "icon": "build/icon.png"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ]
    }
  }
}