{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lunira Screen",
  "version": "0.3.0",
  "identifier": "com.lunira.screen.desktop",
  "build": {
    "frontendDist": "../../frontend",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lunira Screen",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}