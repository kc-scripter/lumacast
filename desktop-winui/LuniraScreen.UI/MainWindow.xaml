<Window x:Class="LuniraScreen.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
 <Grid Background="#111015" RequestedTheme="Dark">
  <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="AppTitleBar" Grid.Row="0" Background="#151319" Padding="16,0"><TextBlock Text="LuniraScreen" FontFamily="Segoe UI Variable" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#DDD6EE"/><TextBlock x:Name="PageTitle" Text="Início" Margin="118,0,0,0" VerticalAlignment="Center" Foreground="#928B9A" FontSize="12"/></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Background="#17151B" Padding="13,18" Spacing="9"><Button Style="{StaticResource IconButton}" Tag="Home" Click="Navigation_Click" ToolTipService.ToolTip="Início"><FontIcon Glyph="&#xE80F;"/></Button><Button Style="{StaticResource IconButton}" Tag="Room" Click="Navigation_Click" ToolTipService.ToolTip="Sala"><FontIcon Glyph="&#xE7F4;"/></Button><StackPanel Height="1" Background="#34303A" Margin="3,8"/><Button Style="{StaticResource IconButton}" Tag="Settings" Click="Navigation_Click" ToolTipService.ToolTip="Configurações"><FontIcon Glyph="&#xE713;"/></Button></StackPanel>
   <Grid Grid.Column="1">
    <Grid x:Name="HomePage" Padding="48,36"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width=".9*"/></Grid.ColumnDefinitions><StackPanel MaxWidth="510" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="9"><Ellipse Width="8" Height="8" Fill="#A78BFA"/><TextBlock Text="LUNIRASCREEN DESKTOP" FontSize="11" FontWeight="SemiBold" Foreground="#AF9BEF" VerticalAlignment="Center"/></StackPanel><TextBlock Text="Compartilhe sua tela&#x0a;sem interromper seu fluxo." FontFamily="Segoe UI Variable Display" FontSize="38" FontWeight="SemiBold" LineHeight="46" Margin="0,19,0,10"/><TextBlock Text="Crie uma sala privada em segundos. Qualidade máxima, controle simples e uma experiência focada no seu trabalho." TextWrapping="Wrap" Foreground="#A19AA9" FontSize="15" LineHeight="23" Margin="0,0,0,27"/><Border Background="#1B191F" BorderBrush="#38333F" BorderThickness="1" CornerRadius="12" Padding="20"><StackPanel Spacing="12"><TextBlock Text="NOVA SALA" FontSize="11" FontWeight="SemiBold" Foreground="#B4A0EE"/><TextBlock Text="Como você quer aparecer?" FontSize="13"/><TextBox x:Name="NameBox" Style="{StaticResource TextBoxStyle}" PlaceholderText="Seu nome"/><Button Style="{StaticResource PrimaryButton}" Click="CreateRoom_Click" HorizontalAlignment="Stretch"><StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center"><FontIcon Glyph="&#xE710;"/><TextBlock Text="Criar sala privada"/></StackPanel></Button></StackPanel></Border><StackPanel Orientation="Horizontal" Spacing="8" Margin="0,17,0,0"><TextBox x:Name="CodeBox" Style="{StaticResource TextBoxStyle}" Width="155" PlaceholderText="CÓDIGO DA SALA"/><Button Style="{StaticResource AppButton}" Click="JoinRoom_Click" Content="Entrar"/></StackPanel></StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="38,0,0,0"><Border Background="#1B191F" BorderBrush="#38333F" BorderThickness="1" CornerRadius="14" Padding="1"><Grid Height="300" Background="#18161D"><Grid.Resources><LinearGradientBrush x:Key="preview" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#302747"/><GradientStop Offset="1" Color="#1A171E"/></LinearGradientBrush></Grid.Resources><Border Background="{StaticResource preview}" CornerRadius="13"/><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="11"><FontIcon Glyph="&#xE714;" FontSize="36" Foreground="#B29AF9" HorizontalAlignment="Center"/><TextBlock Text="Sua transmissão aparece aqui" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Nenhuma sala aberta" Foreground="#9C94A4" HorizontalAlignment="Center"/></StackPanel></Grid></Border><Grid Margin="4,17,4,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PRIVADO" FontSize="10" Foreground="#8F8798"/><TextBlock Text="Protegido" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="DURAÇÃO" FontSize="10" Foreground="#8F8798"/><TextBlock Text="Temporária" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="QUALIDADE" FontSize="10" Foreground="#8F8798"/><TextBlock Text="1080p" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="FLUIDEZ" FontSize="10" Foreground="#8F8798"/><TextBlock Text="60 FPS" FontWeight="SemiBold"/></StackPanel></Grid></StackPanel></Grid>
    <Grid x:Name="RoomPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Background="#18161C" Padding="25,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12"><Ellipse Width="8" Height="8" Fill="#E36C7A"/><StackPanel><TextBlock x:Name="RoomName" Text="Sala privada" FontWeight="SemiBold"/><TextBlock Text="Ao vivo · há 08:42" FontSize="11" Foreground="#97909E"/></StackPanel></StackPanel><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8"><TextBlock Text="NX7K-4M2Q" FontWeight="SemiBold"/><Button Style="{StaticResource AppButton}" Click="CopyCode_Click" Padding="8,5"><TextBlock x:Name="CopyLabel" Text="Copiar" FontSize="11"/></Button></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="9"><TextBlock Text="● Conexão excelente" FontSize="12" Foreground="#84D5AA"/><Button Style="{StaticResource IconButton}" Click="TogglePanel_Click"><FontIcon Glyph="&#xE8A0;"/></Button></StackPanel></Grid>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="294"/></Grid.ColumnDefinitions><Grid Margin="25,21,25,98"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="132"/></Grid.RowDefinitions><Border Background="#1A1820" BorderBrush="#37313E" BorderThickness="1" CornerRadius="12"><Grid><Border Margin="1" CornerRadius="11" Background="#211B2C"/><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"><FontIcon Glyph="&#xE7F4;" FontSize="48" Foreground="#AF95FB" HorizontalAlignment="Center"/><TextBlock Text="Transmissão da sua tela" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="1080p · 60 FPS · conexão estável" Foreground="#A59EAD" HorizontalAlignment="Center"/></StackPanel><Border Background="#271F34" CornerRadius="7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Padding="9,5"><TextBlock Text="COMPARTILHANDO TELA" FontSize="10" Foreground="#D1C1FF"/></Border></Grid></Border><StackPanel Grid.Row="1" Margin="0,15,0,0"><TextBlock Text="CÂMERAS · 3 NA SALA" FontSize="10" Foreground="#958D9D" Margin="0,0,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Height="91" Background="#352B46" CornerRadius="9" Margin="0,0,8,0"><TextBlock Text="LS&#x0a;Você" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold"/></Border><Border Grid.Column="1" Height="91" Background="#3F3038" CornerRadius="9" Margin="4,0"><TextBlock Text="ML&#x0a;Marina" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold"/></Border><Border Grid.Column="2" Height="91" Background="#283D48" CornerRadius="9" Margin="8,0,0,0"><TextBlock Text="RS&#x0a;Rafael" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold"/></Border></Grid></StackPanel></Grid>
      <Border x:Name="ParticipantPanel" Grid.Column="1" Background="#18161C" BorderBrush="#302B34" BorderThickness="1,0,0,0" Padding="18"><StackPanel><TextBlock Text="PARTICIPANTES" FontSize="10" Foreground="#998FA2"/><TextBlock Text="Na sala agora" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,18"/><Button Style="{StaticResource AppButton}" Content="＋ Convidar pessoas" HorizontalAlignment="Stretch"/><StackPanel Margin="0,17,0,0" Spacing="14"><TextBlock Text="LS   Você                 Host"/><TextBlock Text="ML   Marina Lopes        Assistindo" Foreground="#CDC6D6"/><TextBlock Text="RS   Rafael Silva          Assistindo" Foreground="#CDC6D6"/></StackPanel><Border Height="1" Background="#332E38" Margin="0,22,0,17"/><TextBlock Text="CONEXÃO" FontSize="10" Foreground="#998FA2"/><TextBlock Text="Excelente · 24 ms" Margin="0,7,0,0" Foreground="#89D4AB"/><TextBlock Text="8.4 Mbps · perda 0.0%" FontSize="11" Foreground="#9B94A1" Margin="0,4,0,0"/></StackPanel></Border>
      <Border Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,23" Background="#29242F" BorderBrush="#49404F" BorderThickness="1" CornerRadius="13" Padding="7"><StackPanel Orientation="Horizontal" Spacing="7"><ToggleSwitch Toggled="Toggle_Click" IsOn="True" OffContent="" OnContent="" ToolTipService.ToolTip="Câmera"/><ToggleSwitch Toggled="Toggle_Click" IsOn="True" OffContent="" OnContent="" ToolTipService.ToolTip="Compartilhar tela"/><ToggleSwitch Toggled="Toggle_Click" IsOn="True" OffContent="" OnContent="" ToolTipService.ToolTip="Áudio do sistema"/><Button Style="{StaticResource IconButton}" Click="Stats_Click"><FontIcon Glyph="&#xE9D9;"/></Button><Button Style="{StaticResource IconButton}" Click="Leave_Click"><FontIcon Glyph="&#xE8BB;"/></Button></StackPanel></Border>
      <Border x:Name="StatsPopup" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,91" Visibility="Collapsed" Background="#28232E" BorderBrush="#49414E" BorderThickness="1" CornerRadius="10" Padding="14"><StackPanel Spacing="6"><TextBlock Text="ESTATÍSTICAS" FontSize="10" Foreground="#B9A8F4"/><TextBlock Text="1080p  ·  60 FPS" FontWeight="SemiBold"/><TextBlock Text="8.4 Mbps · perda 0.0%" FontSize="11" Foreground="#A49CAA"/></StackPanel></Border>
     </Grid></Grid>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" Padding="55,38"><StackPanel MaxWidth="760"><TextBlock Text="Preferências do aplicativo" FontSize="30" FontFamily="Segoe UI Variable Display" FontWeight="SemiBold"/><TextBlock Text="Ajustes visuais e padrões para suas novas salas." Foreground="#A39BA9" Margin="0,8,0,32"/><TextBlock Text="APARÊNCIA" FontSize="11" Foreground="#B7A1F2"/><Border Background="#1B191F" BorderBrush="#38333F" BorderThickness="1" CornerRadius="10" Padding="17" Margin="0,10,0,27"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Modo escuro" FontWeight="SemiBold"/><TextBlock Text="Tema escuro otimizado para o seu desktop." FontSize="12" Foreground="#9E96A5" Margin="0,4,0,0"/></StackPanel><ToggleSwitch Grid.Column="1" IsOn="True" Click="Toggle_Click" OffContent="" OnContent=""/></Grid></Border><TextBlock Text="TRANSMISSÃO" FontSize="11" Foreground="#B7A1F2"/><Border Background="#1B191F" BorderBrush="#38333F" BorderThickness="1" CornerRadius="10" Padding="17" Margin="0,10,0,27"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Qualidade padrão" FontWeight="SemiBold"/><TextBlock Text="Alta definição com ajuste automático de rede." FontSize="12" Foreground="#9E96A5" Margin="0,4,0,0"/></StackPanel><ComboBox Grid.Column="1" Width="124" SelectedIndex="0"><ComboBoxItem Content="1080p · 60 FPS"/><ComboBoxItem Content="720p · 30 FPS"/></ComboBox></Grid></Border><TextBlock Text="ATUALIZAÇÕES E SOBRE" FontSize="11" Foreground="#B7A1F2"/><Border Background="#1B191F" BorderBrush="#38333F" BorderThickness="1" CornerRadius="10" Padding="17" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="LuniraScreen Desktop" FontWeight="SemiBold"/><TextBlock Text="Versão 1.0.0 · Você está atualizado" FontSize="12" Foreground="#9E96A5" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Style="{StaticResource AppButton}" Content="Verificar agora"/></Grid></Border></StackPanel></ScrollViewer>
   </Grid>
  </Grid>
 </Grid>
</Window>

