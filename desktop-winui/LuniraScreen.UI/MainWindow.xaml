<Window x:Class="LuniraScreen.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
 <Grid Background="#111015" RequestedTheme="Dark">
  <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="AppTitleBar" Grid.Row="0" Background="#151319" Padding="16,0"><TextBlock Text="LuniraScreen" FontFamily="Segoe UI Variable" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#DDD6EE"/><TextBlock x:Name="PageTitle" Text="Início" Margin="118,0,0,0" VerticalAlignment="Center" Foreground="#928B9A" FontSize="12"/></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Background="#17151B" Padding="13,18" Spacing="9"><Button Style="{StaticResource IconButton}" Tag="Home" Click="Navigation_Click" ToolTipService.ToolTip="Início"><FontIcon Glyph="&#xE80F;"/></Button><Button Style="{StaticResource IconButton}" Tag="Room" Click="Navigation_Click" ToolTipService.ToolTip="Sala"><FontIcon Glyph="&#xE7F4;"/></Button><StackPanel Height="1" Background="#34303A" Margin="3,8"/><Button Style="{StaticResource IconButton}" Tag="Settings" Click="Navigation_Click" ToolTipService.ToolTip="Configurações"><FontIcon Glyph="&#xE713;"/></Button></StackPanel>
   <Grid Grid.Column="1">
    <Grid x:Name="HomePage" Padding="48,36"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width=".9*"/></Grid.ColumnDefinitions><StackPanel MaxWidth="510" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="9"><Ellipse Width="8" Height="8" Fill="#A78BFA"/><TextBlock Text="LUNIRASCREEN DESKTOP" FontSize="11" FontWeight="SemiBold" Foreground="#AF9BEF" VerticalAlignment="Center"/></StackPanel><TextBlock Text="Compartilhe sua tela&#x0a;sem interromper seu fluxo." FontFamily="Segoe UI Variable Display" FontSize="38" FontWeight="SemiBold" LineHeight="46" Margin="0,19,0,10"/><TextBlock Text="Crie uma sala privada em segundos. Qualidade máxima, controle simples e uma experiência focada no seu trabalho." TextWrapping="Wrap" Foreground="#A19AA9" FontSize="15" LineHeight="23" Margin="0,0,0,27"/><Border Background="#1B191F" BorderBrush="#38333F" BorderThickness="1" CornerRadius="12" Padding="20"><StackPanel Spacing="12"><TextBlock Text="NOVA SALA" FontSize="11" FontWeight="SemiBold" Foreground="#B4A0EE"/><TextBlock Text="Como você quer aparecer?" FontSize="13"/><TextBox x:Name="NameBox" Style="{StaticResource TextBoxStyle}" PlaceholderText="Seu nome" MaxLength="20"/><Button Style="{StaticResource PrimaryButton}" Click="CreateRoom_Click" HorizontalAlignment="Stretch"><StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center"><FontIcon Glyph="&#xE710;"/><TextBlock Text="Criar sala privada"/></StackPanel></Button></StackPanel></Border><StackPanel Orientation="Horizontal" Spacing="8" Margin="0,17,0,0"><TextBox x:Name="CodeBox" Style="{StaticResource TextBoxStyle}" Width="155" PlaceholderText="CÓDIGO DA SALA" MaxLength="8"/><Button Style="{StaticResource AppButton}" Click="JoinRoom_Click" Content="Entrar"/></StackPanel></StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="38,0,0,0"><Border Background="#1B191F" BorderBrush="#38333F" BorderThickness="1" CornerRadius="14" Padding="1"><Grid Height="300" Background="#18161D"><Grid.Resources><LinearGradientBrush x:Key="preview" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#302747"/><GradientStop Offset="1" Color="#1A171E"/></LinearGradientBrush></Grid.Resources><Border Background="{StaticResource preview}" CornerRadius="13"/><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="11"><FontIcon Glyph="&#xE714;" FontSize="36" Foreground="#B29AF9" HorizontalAlignment="Center"/><TextBlock Text="Sua transmissão aparece aqui" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Nenhuma sala aberta" Foreground="#9C94A4" HorizontalAlignment="Center"/></StackPanel></Grid></Border><Grid Margin="4,17,4,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PRIVADO" FontSize="10" Foreground="#8F8798"/><TextBlock Text="Protegido" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="DURAÇÃO" FontSize="10" Foreground="#8F8798"/><TextBlock Text="Temporária" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="QUALIDADE" FontSize="10" Foreground="#8F8798"/><TextBlock Text="1080p" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="FLUIDEZ" FontSize="10" Foreground="#8F8798"/><TextBlock Text="60 FPS" FontWeight="SemiBold"/></StackPanel></Grid></StackPanel></Grid>
    <Grid x:Name="RoomPage" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Background="#18161C" Padding="24,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
          <Border Width="36" Height="36" CornerRadius="10" Background="#241E30" BorderBrush="#493B61" BorderThickness="1"><FontIcon Glyph="&#xE7F4;" FontSize="17" Foreground="#B79CFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Width="7" Height="7" Fill="#E36C7A" VerticalAlignment="Center"/><TextBlock x:Name="RoomName" Text="Sala privada" FontWeight="SemiBold"/></StackPanel>
            <TextBlock x:Name="RoomLiveText" Text="Aguardando transmissão" FontSize="11" Foreground="#97909E" Margin="14,2,0,0"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="9" Margin="18,0">
          <Border Background="#211E27" BorderBrush="#393440" BorderThickness="1" CornerRadius="8" Padding="11,7"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="SALA" FontSize="9" Foreground="#8F8798" VerticalAlignment="Center"/><TextBlock x:Name="RoomCodeText" Text="--------" FontWeight="SemiBold" CharacterSpacing="50"/></StackPanel></Border>
          <Button Style="{StaticResource AppButton}" Click="CopyCode_Click" Padding="10,7"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8C8;" FontSize="13"/><TextBlock x:Name="CopyLabel" Text="Copiar" FontSize="11"/></StackPanel></Button>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="8">
          <ComboBox x:Name="RoomQualityBox" Style="{StaticResource RoomComboBox}" Width="154" SelectedIndex="0" SelectionChanged="Quality_Changed"><ComboBoxItem Content="1080p · 60 FPS"/><ComboBoxItem Content="1080p · 30 FPS"/><ComboBoxItem Content="720p · 60 FPS"/><ComboBoxItem Content="720p · 30 FPS"/></ComboBox>
          <Button Style="{StaticResource RoomActionButton}" Click="TogglePanel_Click"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE716;" FontSize="15"/><TextBlock x:Name="ParticipantCountText" Text="Pessoas · 1"/></StackPanel></Button>
          <Border Background="#17251F" BorderBrush="#294B3A" BorderThickness="1" CornerRadius="8" Padding="10,7"><TextBlock x:Name="ConnectionText" Text="● Conectando" FontSize="11" Foreground="#84D5AA"/></Border>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="304"/></Grid.ColumnDefinitions>
        <Grid Margin="24,20,24,20">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="128"/><RowDefinition Height="64"/></Grid.RowDefinitions>
          <Border Background="#15131A" BorderBrush="#37313E" BorderThickness="1" CornerRadius="14">
            <Grid>
              <Border Margin="1" CornerRadius="13" Background="#201B2A"/><Image x:Name="ScreenImage" Stretch="Uniform"/>
              <StackPanel x:Name="ScreenEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <Border Width="74" Height="74" CornerRadius="22" Background="#2B2240" BorderBrush="#4E3C72" BorderThickness="1"><FontIcon Glyph="&#xE7F4;" FontSize="31" Foreground="#B18FFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock Text="Nenhuma tela sendo compartilhada" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ScreenHintText" Text="Clique em Compartilhar tela para escolher um monitor ou janela." Foreground="#A59EAD" HorizontalAlignment="Center"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Spacing="7"><Border Background="#271F34" BorderBrush="#45365A" BorderThickness="1" CornerRadius="7" Padding="9,5"><TextBlock Text="PALCO" FontSize="9" Foreground="#D1C1FF"/></Border><Border Background="#1B1920" BorderBrush="#35313B" BorderThickness="1" CornerRadius="7" Padding="9,5"><TextBlock x:Name="StageQualityText" Text="1080p · 60 FPS" FontSize="9" Foreground="#AAA2B2"/></Border></StackPanel>
            </Grid>
          </Border>
          <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="9"><TextBlock Text="CÂMERAS" FontSize="10" FontWeight="SemiBold" Foreground="#A79DAE"/><TextBlock x:Name="CameraCountText" Text="0 ligadas" FontSize="10" Foreground="#746D7A"/></StackPanel>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock x:Name="CameraEmptyText" Grid.ColumnSpan="3" Text="As câmeras dos participantes aparecem aqui." Foreground="#817988" VerticalAlignment="Center"/>
              <Border x:Name="CameraCard0" Visibility="Collapsed" Height="88" Background="#352B46" BorderBrush="#544368" BorderThickness="1" CornerRadius="10" Margin="0,0,7,0"><Grid><Image x:Name="CameraImage0" Stretch="UniformToFill"/><Border VerticalAlignment="Bottom" Background="#B0101116" Padding="8,5"><TextBlock x:Name="CameraLabel0" Text="Você" FontSize="11"/></Border></Grid></Border>
              <Border x:Name="CameraCard1" Visibility="Collapsed" Grid.Column="1" Height="88" Background="#3F3038" BorderBrush="#60434D" BorderThickness="1" CornerRadius="10" Margin="4,0"><Grid><Image x:Name="CameraImage1" Stretch="UniformToFill"/><Border VerticalAlignment="Bottom" Background="#B0101116" Padding="8,5"><TextBlock x:Name="CameraLabel1" Text="Participante" FontSize="11"/></Border></Grid></Border>
              <Border x:Name="CameraCard2" Visibility="Collapsed" Grid.Column="2" Height="88" Background="#283D48" BorderBrush="#3A5968" BorderThickness="1" CornerRadius="10" Margin="7,0,0,0"><Grid><Image x:Name="CameraImage2" Stretch="UniformToFill"/><Border VerticalAlignment="Bottom" Background="#B0101116" Padding="8,5"><TextBlock x:Name="CameraLabel2" Text="Participante" FontSize="11"/></Border></Grid></Border>
            </Grid>
          </Grid>
          <Border Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#211E27" BorderBrush="#403A48" BorderThickness="1" CornerRadius="13" Padding="7">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <ToggleButton x:Name="CameraToggle" Style="{StaticResource RoomToggleButton}" Tag="Camera" Click="Toggle_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE714;" FontSize="16"/><TextBlock x:Name="CameraActionText" Text="Câmera"/></StackPanel></ToggleButton>
              <ToggleButton x:Name="ShareToggle" Style="{StaticResource RoomToggleButton}" Tag="Screen" Click="Toggle_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7F4;" FontSize="16"/><TextBlock x:Name="ShareActionText" Text="Compartilhar tela"/></StackPanel></ToggleButton>
              <ToggleButton x:Name="AudioToggle" Style="{StaticResource RoomToggleButton}" Tag="Audio" Click="Toggle_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE767;" FontSize="16"/><TextBlock x:Name="AudioActionText" Text="Áudio do sistema"/></StackPanel></ToggleButton>
              <Border Width="1" Background="#453E4B" Margin="3,5"/>
              <Button Style="{StaticResource RoomActionButton}" Click="Stats_Click"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE9D9;" FontSize="15"/><TextBlock Text="Stats"/></StackPanel></Button>
              <Button Style="{StaticResource DangerActionButton}" Click="Leave_Click"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8BB;" FontSize="15"/><TextBlock Text="Sair"/></StackPanel></Button>
            </StackPanel>
          </Border>
        </Grid>
        <Border x:Name="ParticipantPanel" Grid.Column="1" Background="#18161C" BorderBrush="#302B34" BorderThickness="1,0,0,0" Padding="18,20">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><StackPanel><TextBlock Text="PARTICIPANTES" FontSize="10" Foreground="#998FA2"/><TextBlock Text="Na sala agora" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel><Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Click="TogglePanel_Click"><FontIcon Glyph="&#xE711;" FontSize="14"/></Button></Grid>
            <Button Grid.Row="1" Style="{StaticResource AppButton}" Click="Invite_Click" HorizontalAlignment="Stretch" Margin="0,18,0,14"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7"><FontIcon Glyph="&#xE710;" FontSize="14"/><TextBlock Text="Convidar pessoas"/></StackPanel></Button>
            <ScrollViewer Grid.Row="2"><StackPanel x:Name="ParticipantsList" Spacing="10"><TextBlock Text="Aguardando participantes…" Foreground="#8F8798"/></StackPanel></ScrollViewer>
            <StackPanel Grid.Row="3"><Border Height="1" Background="#332E38" Margin="0,16,0,16"/><TextBlock Text="CONEXÃO" FontSize="10" Foreground="#998FA2"/><TextBlock x:Name="MediaStatusText" Text="Conectando…" Margin="0,7,0,0" Foreground="#89D4AB"/><TextBlock x:Name="RoomStatusText" Text="" TextWrapping="Wrap" FontSize="11" Foreground="#9B94A1" Margin="0,4,0,0"/></StackPanel>
          </Grid>
        </Border>
        <Border x:Name="StatsPopup" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,88" Visibility="Collapsed" Background="#28232E" BorderBrush="#51465A" BorderThickness="1" CornerRadius="11" Padding="16"><StackPanel Spacing="7"><TextBlock Text="ESTATÍSTICAS DA SALA" FontSize="10" Foreground="#B9A8F4"/><TextBlock x:Name="StatsQualityText" Text="1080p · 60 FPS" FontWeight="SemiBold"/><TextBlock x:Name="StatsText" Text="Signaling — · LiveKit — · Agora —" FontSize="11" Foreground="#A49CAA"/></StackPanel></Border>
      </Grid>
    </Grid>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" Padding="55,38"><StackPanel MaxWidth="760"><TextBlock Text="Preferências do aplicativo" FontSize="30" FontFamily="Segoe UI Variable Display" FontWeight="SemiBold"/><TextBlock Text="Ajustes visuais e padrões para suas novas salas." Foreground="#A39BA9" Margin="0,8,0,32"/><TextBlock Text="APARÊNCIA" FontSize="11" Foreground="#B7A1F2"/><Border Background="#1B191F" BorderBrush="#38333F" BorderThickness="1" CornerRadius="10" Padding="17" Margin="0,10,0,27"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Modo escuro" FontWeight="SemiBold"/><TextBlock Text="Tema escuro otimizado para o seu desktop." FontSize="12" Foreground="#9E96A5" Margin="0,4,0,0"/></StackPanel><ToggleSwitch Grid.Column="1" IsOn="True" Toggled="Toggle_Click" OffContent="" OnContent=""/></Grid></Border><TextBlock Text="TRANSMISSÃO" FontSize="11" Foreground="#B7A1F2"/><Border Background="#1B191F" BorderBrush="#38333F" BorderThickness="1" CornerRadius="10" Padding="17" Margin="0,10,0,27"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Qualidade padrão" FontWeight="SemiBold"/><TextBlock Text="Alta definição com ajuste automático de rede." FontSize="12" Foreground="#9E96A5" Margin="0,4,0,0"/></StackPanel><ComboBox Grid.Column="1" Width="124" SelectedIndex="0"><ComboBoxItem Content="1080p · 60 FPS"/><ComboBoxItem Content="720p · 30 FPS"/></ComboBox></Grid></Border><TextBlock Text="ATUALIZAÇÕES E SOBRE" FontSize="11" Foreground="#B7A1F2"/><Border Background="#1B191F" BorderBrush="#38333F" BorderThickness="1" CornerRadius="10" Padding="17" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="LuniraScreen Desktop" FontWeight="SemiBold"/><TextBlock x:Name="UpdateStatusText" Text="Verificação automática ativada." FontSize="12" Foreground="#9E96A5" Margin="0,4,0,0"/></StackPanel><Button x:Name="UpdateButton" Grid.Column="1" Style="{StaticResource AppButton}" Content="Verificar agora" Click="Update_Click"/></Grid></Border></StackPanel></ScrollViewer>
   </Grid>
  </Grid>
 </Grid>
</Window>

